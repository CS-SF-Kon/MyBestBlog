@using MyBestBlog.Core.Entities
@model List<ArticlePreviewViewModel>

@{
    ViewData["Title"] = "Главная";
    var currentTag = ViewData["CurrentTag"] as Tag;
}

<div class="container">
    <h1 class="mb-4">
        @if (currentTag != null)
        {
            <span>Статьи с тегом: </span>
            <span class="badge bg-primary">@currentTag.Name</span>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary ms-2">
                Показать все статьи
            </a>
        }
        else
        {
            <span>Последние статьи</span>
        }
    </h1>
    
    @if (User.Identity.IsAuthenticated)
    {
        <div class="mb-4">
            <a asp-controller="Article" asp-action="Create" class="btn btn-success">Новая статья</a>
        </div>
    }

    @if (Model?.Any() == true)
    {
        foreach (var article in Model)
        {
            <div class="card mb-3 position-relative">
                <div class="position-absolute top-0 end-0 m-2">
                    @foreach (var tag in article.Tags.Take(3))
                    {
                        <span class="badge bg-primary me-1">@tag.Name</span>
                    }
                    @if (article.Tags.Count > 3)
                    {
                        <span class="badge bg-secondary">+@(article.Tags.Count - 3)</span>
                    }
                </div>

                <div class="card-body">
                    <h5 class="card-title">@article.Title</h5>

                    <div class="d-flex justify-content-between mb-2">
                        <small class="text-muted">
                            Опубликовано: @article.CreatedAt.ToString("dd.MM.yyyy")
                        </small>
                        <small>
                            Автор:
                            <a asp-controller="User" asp-action="Profile"
                               asp-route-id="@article.Author.Id" class="text-decoration-none">
                                @article.Author.UserName
                            </a>
                        </small>
                    </div>

                    <div class="card-text mb-3 text-truncate-container" style="max-height: 60px; overflow: hidden;">
                        @article.PreviewContent
                    </div>

                    <div class="d-flex gap-2">
                        <a asp-controller="Article" asp-action="Details" asp-route-id="@article.Id"
                           class="btn btn-outline-primary">
                            Читать <i class="bi bi-book"></i>
                        </a>

                        @if (User.IsInRole("Admin") || User.IsInRole("Moderator"))
                        {
                            <form asp-controller="Article" asp-action="Delete" asp-route-id="@article.Id"
                                  method="post" class="d-inline">
                                <button type="submit" class="btn btn-danger">Удалить</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-info">
            Статьи пока не добавлены
        </div>
    }
</div>

<style>
    /* Опционально: стиль для многоточия при обрезке текста */
    .text-truncate-container {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>