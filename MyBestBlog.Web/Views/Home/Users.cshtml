@using MyBestBlog.Core.Entities
@model List<UserListViewModel>

@{
    ViewData["Title"] = "Пользователи";
}

<div class="container">
    <h1 class="mb-4">Пользователи блога</h1>

    @if (Model?.Any() == true)
    {
        foreach (var user in Model)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">
                        @user.UserName
                        <span class="badge bg-secondary ms-2">@user.Role</span>
                    </h5>

                    @if (user.Articles.Any())
                    {
                        <h6 class="mt-3 mb-2">Статьи пользователя:</h6>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var article in user.Articles)
                            {
                                <a asp-controller="Article" asp-action="Details" asp-route-id="@article.Id"
                                   class="badge bg-primary text-decoration-none">
                                    @article.Title
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Пользователь пока не написал ни одной статьи</p>
                    }

                    <div class="mt-3">
                        <a asp-controller="User" asp-action="Profile" asp-route-id="@user.Id"
                           class="btn btn-primary">Профиль пользователя</a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-info">
            Пользователей пока нет
        </div>
    }
</div>