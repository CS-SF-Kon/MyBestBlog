@model MyBestBlog.Web.Models.ArticleDetailsViewModel

@{
    ViewData["Title"] = Model.Article.Title;
}

<div class="container">
    <div class="card">
        <div class="card-body">
            <div class="mb-3">
                @foreach (var tag in Model.Article.Tags)
                {
                    <span class="badge bg-primary me-1">@tag.Tag.Name</span>
                }
            </div>

            <h1 class="card-title">@Model.Article.Title</h1>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <small class="text-muted">
                    Автор: 
                    <a asp-controller="User" asp-action="Profile"
                       asp-route-id="@Model.Article.Author?.Id" class="text-decoration-none">
                        @Model.Article.Author?.UserName
                    </a>
                </small>
                <small class="text-muted">
                    @Model.Article.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                </small>
            </div>

            <div class="card-text mb-4">
                @Html.Raw(Model.Article.Content.Replace("\n", "<br/>"))
            </div>

            <div class="d-flex gap-2">
                <a asp-controller="Article" asp-action="Edit" asp-route-id="@Model.Article.Id"
                   class="btn btn-primary @(Model.CanEdit ? "" : "d-none")">
                    Редактировать
                </a>

                @if (Model.CanDelete)
                {
                    <form asp-controller="Article" asp-action="Delete" asp-route-id="@Model.Article.Id"
                          method="post" class="d-inline">
                        <button type="submit" class="btn btn-danger">Удалить</button>
                    </form>
                }

                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary ms-auto">
                    На главную
                </a>
            </div>

            @if (User.Identity.IsAuthenticated)
            {
                <div class="mt-4">
                    <h4>Добавить комментарий</h4>
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">@TempData["Error"]</div>
                    }
                    <form asp-controller="Article" asp-action="AddComment" method="post">
                        <input type="hidden" name="ArticleId" value="@Model.Article.Id" />
                        <div class="form-group mb-2">
                            <textarea name="Text" class="form-control" rows="3"></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary">Отправить</button>
                        @Html.AntiForgeryToken()
                    </form>
                </div>
            }
            else
            {
                <div class="alert alert-info mt-4">
                    <a asp-controller="Auth" asp-action="Login">Войдите</a>, чтобы оставить комментарий
                </div>
            }

            <!-- Список комментариев -->
            <div class="mt-4">
                <h4>Комментарии (@Model.Comments.Count)</h4>
                @if (Model.Comments.Any())
                {
                    <div class="list-group mt-3">
                        @foreach (var comment in Model.Comments)
                        {
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between">
                                    <strong>
                                        <a asp-controller="User" asp-action="Profile"
                                           asp-route-id="@comment.AuthorId">
                                            @comment.AuthorName
                                        </a>
                                    </strong>
                                    <small class="text-muted">@comment.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                                </div>
                                <p class="mb-1 mt-2">@comment.Text</p>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted">Комментариев пока нет</p>
                }
            </div>
        </div>
    </div>   
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}