@model MyBestBlog.Web.Models.TagListViewModel

@{
    ViewData["Title"] = "Все теги";
}

<div class="container">
    <h1 class="mb-4">@ViewData["Title"]</h1>

    @if (Model.CanCreate)
    {
        <div class="mb-4">
            <a asp-action="Create" class="btn btn-success">Создать тег</a>
        </div>
    }

    @if (Model.Tags?.Any() == true)
    {
        <div class="row">
            @foreach (var tag in Model.Tags)
            {
                <div class="col-md-4 mb-3">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <h5 class="card-title">
                                    <a asp-controller="Home" asp-action="Index" asp-route-tagId="@tag.Id"
                                       class="text-decoration-none">
                                        <span class="badge bg-primary">@tag.Name</span>
                                    </a>
                                </h5>
                                @if (Model.CanCreate)
                                {
                                    <a asp-action="Edit" asp-route-id="@tag.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil">Редактировать тег</i>
                                    </a>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(tag.Description))
                            {
                                <p class="card-text">@tag.Description</p>
                            }
                            <small class="text-muted">
                                @{
                                    var articleCount = tag.Articles?.Count ?? 0;
                                }
                                Статей: @articleCount
                            </small>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            Теги не найдены
        </div>
    }
</div>